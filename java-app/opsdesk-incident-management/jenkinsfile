pipeline {
    agent {
        label 'agent1'
    }
    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true) 
    } 
    parameters {
        choice(name: 'Deployment_Method', choices: ['deploy', 'rollback'], description: 'Select the method to deploy')
        string(name: 'New_version', defaultValue: 'v1.0', description: 'Deploying updated version')

    }

    environment {
        IMAGE_TAG = "${params.New_version}"
        SONAR_PROJECT_KEY = 'opsdesk'
        SONAR_PROJECT_NAME = 'OpsDesk Incident Management'
        DOCKERHUB_REPO = 'praneshdoc07/jen-app'
        APP_DIR = 'java-app/opsdesk-incident-management'

    } 
    stages{
        // ==========================================
        // 1. CHECKOUT SOURCE CODE
        // Runs for both DEPLOY and ROLLBACK
        // ==========================================

        
        stage('checkout'){
            steps{
                checkout scm

                stash(

                    name: 'ansible-files',
                    includes: 'java-app/opsdesk-incident-management/Ansible-CD/**',
                    useDefaultExcludes: false
                )
            }
        }
        // ==========================================
        // 2. GITLEAKS SECRET SCAN
        // ==========================================
        
        stage('Git-leak'){
             when {
                beforeAgent true
                expression {
                    params.Deployment_Method == 'deploy'
                }
            } 
            
            agent {
                docker {
                    label 'agent1'
                    image 'ghcr.io/gitleaks/gitleaks:v8.24.2'
                    args '--entrypoint=""' 
                    reuseNode true
        // reuseNode true allows the Docker agent to reuse the same workspace on the Jenkins node, which can be beneficial for performance and resource management. It avoids creating a new workspace for each build, thus saving time and resources.
        // --entrypoint=""' is used to override the default entrypoint of the Docker image, allowing us to run custom commands inside the container.
                }
            }
              
            steps{
                
                sh '''
                    gitleaks detect \
                      --source="$WORKSPACE/$APP_DIR" \
                      --redact \
                      --exit-code 1
                '''
            }
        }
        // =========================================
        // 3. MAVEN CI
        // One temporary Java 17 container for:
        // Build + Test + SpotBugs + OWASP
        // =========================================

        stage('Maven CI'){
            when {
                beforeAgent true
                expression {
                    params.Deployment_Method == 'deploy'
                }
            }
            agent {
                docker {
                    label 'agent1'
                    image 'maven:3.9.9-eclipse-temurin-17'
                    reuseNode true
                    args '-v maven-repo-cache:/root/.m2' 
                }
                
            }
              
            stages{
                stage('Build'){
                    steps{
                        dir("$APP_DIR"){
                        sh 'mvn clean verify'
                        //verify phase includes compile, test, and package phases, so it will build the project, run tests, and package the application.
                        //clean package will remove any previous build artifacts and then package the application into a distributable format (e.g., JAR, WAR).
                    }
                post {

                        always {

                            junit(
                                testResults: '$APP_DIR/target/surefire-reports/*.xml',
                                allowEmptyResults: true
                            )

                            archiveArtifacts(
                                artifacts: '$APP_DIR/target/*.jar',
                                fingerprint: true,
                                allowEmptyArchive: true
                            )
                        }
                    }
                }
                // ---------------------------------
                // 3.2 SPOTBUGS
                // ---------------------------------
                stage('SpotBugs'){
                    steps{
                        dir("$APP_DIR"){
                        sh '''
                            mvn spotbugs:check
                        '''                    }
                }
                // ---------------------------------
                // 3.3 OWASP DEPENDENCY CHECK
                // ---------------------------------

                stage('OWASP Dependency Check') {

                    steps {
                        dir("$APP_DIR"){

                        sh '''
                            mvn org.owasp:dependency-check-maven:check
                        '''
                    }

                    post {

                        always {

                            archiveArtifacts(
                                artifacts: '$APP_DIR/target/dependency-check-report.html',
                                allowEmptyArchive: true
                            )
                        }
                    }
                }


        // =========================================
        // 4. SONARQUBE ANALYSIS
        // Separate temporary Java 21 container
        // =========================================
            }
        }

        stage('SonarQube Analysis'){
            when {
                beforeAgent true
                expression {
                    params.Deployment_Method == 'deploy'
                }
            }
            agent {
                docker {
                    label 'agent1'
                    image 'maven:3.9.9-eclipse-temurin-21'
                    reuseNode true
                    args '-v maven-repo-cache:/root/.m2' 
                }
                
            }
              
            steps{
                withSonarQubeEnv('SonarQube-Server') {
                    withCredentials([
                        string(
                            credentialsId: 'sonarqube-token',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {
                    sh '''
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                              -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                              -Dsonar.projectName="$SONAR_PROJECT_NAME" \
                              -Dsonar.host.url="$SONAR_HOST_URL" \
                              -Dsonar.token="$SONAR_TOKEN" \
                              -Dsonar.java.binaries=$APP_DIR/target/classes \
                              -Dsonar.coverage.jacoco.xmlReportPaths=$APP_DIR/target/site/jacoco/jacoco.xml
                    '''
                }
            }
        }


        // =========================================
        // 6. DOCKER IMAGE BUILD
        // Runs directly on build agent
        // =========================================

        stage('Docker Build') {

            when {
                beforeAgent true
                expression {
                    params.Deployment_Method == 'deploy'
                }
            }
           

            steps {
                dir("$APP_DIR"){
                sh '''
                    docker build \
                      -t "$DOCKERHUB_REPO:${IMAGE_TAG}" -f Dockerfile .
                '''
            }
        }

        // =========================================
        // 7. TRIVY IMAGE SCAN
        // Temporary Trivy Docker container
        // =========================================

        stage('Trivy Scan') {

            when {
                beforeAgent true
                expression {
                    params.Deployment_Method == 'deploy'
                }
            }
            

            steps {

                sh '''
                    trivy image \
                      --exit-code 1 \
                      --severity HIGH,CRITICAL \
                      "$DOCKERHUB_REPO:${IMAGE_TAG}"
                '''
            }
        }

        // =========================================
        // 8. DOCKER HUB PUSH
        // Already logged in on build agent
        // =========================================

        stage('Docker Hub Push') {

            when {
                beforeAgent true
                expression {
                    params.Deployment_Method == 'deploy'
                }
            }

            steps {

                sh '''
                    docker push "$DOCKERHUB_REPO:${IMAGE_TAG}"
                '''
            }
        }

        // =========================================
        // 9. ANSIBLE AUTOMATIC DEPLOYMENT
        // deploy.yml handles automatic rollback
        // if new deployment smoke test fails
        // =========================================

        stage('Ansible Deploy') {

            when {
                beforeAgent true
                expression {
                    params.Deployment_Method == 'deploy'
                }
            }

            agent {
                label 'ansible'
            }

            steps {

                deleteDir()

                unstash 'ansible-files'


                sh '''
                        ansible-playbook \
                          -i /java-app/opsdesk-incident-management/Ansible-CD/inventory.ini \
                          /java-app/opsdesk-incident-management/Ansible-CD/deploy.yml \
                          -e "image_name=${DOCKERHUB_REPO}" \
                          -e "image_tag=${IMAGE_TAG}"
                    '''
                
            }
        }


        // =========================================
        // 10. MANUAL ROLLBACK
        // Skips all CI and image build stages
        // =========================================

        stage('Ansible Rollback') {

            when {
                beforeAgent true
                expression {
                    params.Deployment_Method == 'rollback'
                }
            }

            agent {
                label 'ansible'
            }

            steps {

                deleteDir()

                unstash 'ansible-files'

                sh '''
                        ansible-playbook \
                          -i /java-app/opsdesk-incident-management/Ansible-CD/inventory.ini \
                          /java-app/opsdesk-incident-management/Ansible-CD/rollback.yml \
                          -e "image_name=${DOCKERHUB_REPO}" \
                          -e "image_tag=${IMAGE_TAG}"
                    '''

            
                }
            }
        }
    }


    // =========================================
    // POST BUILD
    // =========================================

    post {

        success {

            echo """
                Pipeline completed successfully.

                ACTION: ${params.Deployment_Method}
                IMAGE: ${DOCKERHUB_REPO}:${IMAGE_TAG}
            """
        }

        failure {

            echo """
                Pipeline failed.

                ACTION: ${params.Deployment_Method}
                IMAGE: ${DOCKERHUB_REPO}:${IMAGE_TAG}

                Check Jenkins console output.
            """
        }

        always {

            echo 'OpsDesk CI/CD pipeline execution completed.'
        }
    

    }

}