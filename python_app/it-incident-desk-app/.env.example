# PostgreSQL connection used by app.py and db_init.py
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesk_db
DB_USER=helpdesk
DB_PASSWORD=admin@123

# User that is allowed to CREATE DATABASE (often postgres for local bootstrap)
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=admin@123
DB_MAINTENANCE_DB=postgres

# JWT signing key
JWT_SECRET=admin@123
ACCESS_TOKEN_MINUTES=60

# Initial seed accounts - CHANGE ALL PASSWORDS before running db_init.py
SEED_ADMIN_EMAIL=admin@helpdesk.local
SEED_ADMIN_PASSWORD=admin@123
SEED_SUPPORT_EMAIL=support@helpdesk.local
SEED_SUPPORT_PASSWORD=ChangeThisSupport123!
SEED_USER_EMAIL=user@helpdesk.local
SEED_USER_PASSWORD=ChangeThisUser123!
