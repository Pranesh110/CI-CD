
pipeline {

    agent {
        label 'agent1'
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'v1.0',
            description: 'Docker image version to build and deploy'
        )
    }

    environment {
        APP_DIR = 'python_app'

        WEB_IMAGE = "praneshdoc07/py_student_reg:${params.IMAGE_TAG}"
        APP_IMAGE = "praneshdoc07/nginx_student_reg:${params.IMAGE_TAG}"
        DB_IMAGE  = 'praneshdoc07/mariadb_student_reg:16'

        SONAR_PROJECT_KEY = 'Student-registration'

        DEV_URL = 'http://13.233.136.182:80'
        PROD_URL = 'http://PROD_SERVER_IP:80'
    }

    stages {

        // ==========================================
        // 1. CHECKOUT
        // ==========================================

        stage('Checkout') {
            steps {
                checkout scm

                echo 'Student Registration source code checked out'

                stash name: 'ansible-files',
                      includes: 'python_app/ansible/**'
            }
        }

        // ==========================================
        // 2. GITLEAKS SECRET SCAN
        // ==========================================

        stage('Secret Scan - Gitleaks') {

            agent {
                docker {
                    label 'agent1'
                    image 'ghcr.io/gitleaks/gitleaks:v8.24.2'
                    args '--entrypoint=""'
                    reuseNode true
                }
            }

            steps {
                sh '''
                    gitleaks detect \
                      --source="$WORKSPACE/$APP_DIR" \
                      --redact \
                      --exit-code 1
                '''
            }
        }

        // ==========================================
        // 3. PYTHON BUILD AND TEST
        // ==========================================

        stage('Python Build and Test') {

            agent {
                docker {
                    image 'python:3.12-slim'
                    label 'agent1'
                    reuseNode true
                }
            }

            steps {

                dir("${APP_DIR}/python") {

                    sh '''
                        set -e

                        echo "Python version"
                        python --version

                        echo "Creating virtual environment"
                        python -m venv .venv
                        . .venv/bin/activate

                        echo "Installing dependencies"
                        python -m pip install --upgrade pip

                        pip install -r requirements.txt
                        pip install pytest pytest-cov httpx ruff bandit

                        echo "Running Pytest and Coverage"

                        # Verify Flask application import
                        python -c "from app import app; print('Flask app imported successfully')"

                        # Run tests
                        python -m pytest tests/ \
                            --cov=app \
                            --cov-report=xml \
                            --cov-report=term-missing

                        echo "Running Ruff"
                        
                        ruff check .

                        echo "Running Bandit"
                        bandit -r . \
                            --exclude ./.venv,./tests \
                            --severity-level medium \
                            --confidence-level medium
                        

                        echo "Python Build and Test completed"
                    '''
                }

                archiveArtifacts(
                    artifacts: 'python_app/python/coverage.xml',
                    allowEmptyArchive: true
                )
            }
        }

        // ==========================================
        // 4. SONARQUBE ANALYSIS
        // ==========================================

        stage('SonarQube Analysis') {
            
            steps {

                dir("${APP_DIR}/python") {

                    script {

                        def scannerHome = tool 'SonarScanner'

                        withSonarQubeEnv('SonarQube-Server1') {

                            withCredentials([
                                string(
                                    credentialsId: 'sonar',
                                    variable: 'SONAR_TOKEN'
                                )
                            ]) {

                                sh """
                                    ${scannerHome}/bin/sonar-scanner \
                                      -Dsonar.projectKey=${SONAR_PROJECT_KEY} \
                                      -Dsonar.projectName=Student-Registration \
                                      -Dsonar.sources=. \
                                      -Dsonar.tests=tests \
                                      -Dsonar.python.version=3.12 \
                                      -Dsonar.python.coverage.reportPaths=coverage.xml \
                                      -Dsonar.exclusions=.venv/**,**/__pycache__/** \
                                      -Dsonar.token=\\$SONAR_TOKEN
                                """
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // 5. BUILD DOCKER IMAGES
        // ==========================================

        stage('Build Docker Images') {

            steps {

                sh '''
                    set -e

                    echo "Building Python application image"

                    docker build \
                      -t "$WEB_IMAGE" \
                      -f python_app/python/pythondockerfile \
                      python_app/python/

                    echo "Building MariaDB image"

                    docker build \
                      -t "$DB_IMAGE" \
                      -f python_app/mariadb/dbdockerfile \
                      python_app/mariadb/

                    echo "Building NGINX image"

                    docker build \
                      -t "$APP_IMAGE" \
                      -f python_app/nginx/nginxdockerfile \
                      python_app/nginx/

                    echo "All three Docker images built successfully"

                    docker images
                '''
            }
        }

        // ==========================================
        // 6. PUSH IMAGES TO DOCKER HUB
        // ==========================================

        stage('Push Images to Docker Hub') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "$DOCKER_PASS" | docker login \
                          -u "$DOCKER_USER" \
                          --password-stdin

                        docker push "$WEB_IMAGE"
                        docker push "$DB_IMAGE"
                        docker push "$APP_IMAGE"

                        docker logout
                    '''
                }
            }
        }

        // ==========================================
        // 7. DEPLOY TO DEV
        // ==========================================

        stage('Deploy to Dev') {

            agent {
                label 'ansible'
            }

            steps {

                deleteDir()

                unstash 'ansible-files'

                sh '''
                    ansible-playbook \
                      -i python_app/ansible/inventory.ini \
                      python_app/ansible/dev.yml
                '''
            }
        }

        // ==========================================
        // 8. DEV HEALTH CHECK
        // ==========================================

        stage('Dev Health Check') {

            steps {

                sh '''
                    echo "Checking Dev application health"

                    curl --fail --retry 10 --retry-delay 5 \
                      "$DEV_URL/api/health"

                    echo "Dev application is healthy"
                '''
            }
        }

        // ==========================================
        // 9. PRODUCTION APPROVAL
        // ==========================================

        stage('Production Approval') {

            steps {

                timeout(time: 24, unit: 'HOURS') {

                    input(
                        message: "Dev deployment successful. Deploy ${WEB_IMAGE} to Production?",
                        ok: 'Approve Production Deployment'
                    )
                }
            }
        }

        // ==========================================
        // 10. DEPLOY TO PRODUCTION
        // ==========================================

        stage('Deploy to Production') {

            agent {
                label 'ansible'
            }

            steps {

                deleteDir()

                unstash 'ansible-files'

                sh '''
                    ansible-playbook \
                      -i python_app/ansible/inventory.ini \
                      python_app/ansible/prod.yml
                '''
            }
        }

        // ==========================================
        // 11. PRODUCTION HEALTH CHECK
        // ==========================================

        stage('Production Health Check') {

            steps {

                sh '''
                    echo "Checking Production application health"

                    curl --fail --retry 10 --retry-delay 5 \
                      "$PROD_URL/api/health"

                    echo "Production application is healthy"
                '''
            }
        }
    }

    // ==========================================
    // POST BUILD ACTIONS
    // ==========================================

    post {

        success {
            echo 'Student Registration CI/CD pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage and deployment logs.'
        }

        aborted {
            echo 'Pipeline was aborted.'
        }

        always {
            sh 'docker logout || true'
            
        }
    }
}
