pipeline {
    agent any
    
    tools {
     maven 'mymaven'
}
    environment {
        name = 'maven-jenkins'
    }
    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'main', description: 'Branch to build')
    }
    stages {
        stage('Build') {
            steps {
                sh 'mvn clean package'
                echo "Build completed for ${env.name}"
                echo "Building branch: ${params.BRANCH_NAME}"
            }

            post {
                success {
                    archiveArtifacts artifacts: 'target/*.jar'
                }
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('parallel stage'){
            parallel{
                stage('test1'){
                    steps{
                        echo "test1"
                    }
                }
                stage('test2'){
                    steps{
                        echo "test2"
                    }
                }
            }
        }

    }
}
